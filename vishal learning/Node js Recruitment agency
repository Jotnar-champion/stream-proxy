// hooks/useRankingSocket.ts
import { useEffect, useRef, useState, useCallback } from 'react';
import { io, Socket } from 'socket.io-client';

export interface RankingResult {
  resumeId: string; applicantName: string; rank?: number;
  score: number; tier: 'Strong Yes' | 'Yes' | 'Maybe' | 'No';
  skillScore: number; experienceScore: number; projectScore: number;
  companyTypeScore: number; achievementScore: number;
}

export function useRankingSocket(jobProfileId: string, token: string) {
  const [progress, setProgress] = useState(0);
  const [results, setResults] = useState<RankingResult[]>([]);
  const [isComplete, setIsComplete] = useState(false);
  const [excelUrl, setExcelUrl] = useState<string | null>(null);
  const socketRef = useRef<Socket | null>(null);

  useEffect(() => {
    if (!jobProfileId || !token) return;
    const socket = io(process.env.NEXT_PUBLIC_SOCKET_URL!, {
      auth: { token }, withCredentials: true,
    });
    socketRef.current = socket;

    socket.on('connect', () => socket.emit('subscribe', { jobProfileId }));
    socket.on('ranking:progress', (p: { percent: number }) => setProgress(p.percent));
    socket.on('ranking:result', (e: { result: RankingResult }) => {
      setResults((prev) => {
        const next = prev.filter((r) => r.resumeId !== e.result.resumeId);
        next.push(e.result);
        return next.sort((a, b) => b.score - a.score)
                   .map((r, i) => ({ ...r, rank: i + 1 }));
      });
    });
    socket.on('ranking:complete', (e: { excelUrl: string }) => {
      setIsComplete(true);
      setExcelUrl(e.excelUrl);
      setProgress(100);
    });

    return () => { socket.emit('unsubscribe', { jobProfileId }); socket.disconnect(); };
  }, [jobProfileId, token]);

  const reset = useCallback(() => {
    setProgress(0); setResults([]); setIsComplete(false); setExcelUrl(null);
  }, []);

  return { progress, results, isComplete, excelUrl, reset };
}
