## 3.5 RBAC Middleware (Express.js)

```js
// middleware/rbac.js
const jwt = require('jsonwebtoken');
const Redis = require('ioredis');
const redis = new Redis(process.env.REDIS_URL);

function extractToken(req) {
  const auth = req.headers.authorization || '';
  if (auth.startsWith('Bearer ')) return auth.slice(7);
  if (req.cookies && req.cookies.access_token) return req.cookies.access_token;
  return null;
}

async function authenticate(req, res, next) {
  const token = extractToken(req);
  if (!token) return res.status(401).json({ error: 'Missing authentication token' });
  try {
    const payload = jwt.verify(token, process.env.JWT_ACCESS_SECRET);
    // logout blacklist check
    if (payload.jti && (await redis.exists(`jwt:blacklist:${payload.jti}`))) {
      return res.status(401).json({ error: 'Token revoked' });
    }
    req.user = payload; // { user_id, role, agency_id, assigned_job_profile_ids[] }
    next();
  } catch (err) {
    return res.status(401).json({ error: 'Invalid or expired token' });
  }
}

/**
 * requireRole(['AgencyAdmin','Recruiter']) — authenticate then authorize.
 * For HR, optionally enforce job-profile ownership via req.params.jobProfileId.
 */
function requireRole(allowedRoles, { enforceOwnershipForHR = true } = {}) {
  return [
    authenticate,
    (req, res, next) => {
      const { role, assigned_job_profile_ids = [] } = req.user;
      if (!allowedRoles.includes(role)) {
        return res.status(403).json({ error: 'Insufficient permissions', required: allowedRoles });
      }
      if (role === 'HR' && enforceOwnershipForHR) {
        const jpId = req.params.jobProfileId || req.body.job_profile_id || req.query.job_profile_id;
        if (jpId && !assigned_job_profile_ids.includes(jpId)) {
          return res.status(403).json({ error: 'Not assigned to this job profile' });
        }
      }
      next();
    },
  ];
}

module.exports = { authenticate, requireRole };
