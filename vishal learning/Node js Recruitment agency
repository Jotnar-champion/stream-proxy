/**
 * Run the full RAG + ranking pipeline for a job profile.
 */
async function runRanking({ jobProfileId, correlationId }) {
  const runId = uuidv4();
  const io = getIO();

  const jpRes = await pool.query(`SELECT * FROM job_profiles WHERE id=$1`, [jobProfileId]);
  const jp = jpRes.rows[0];
  const company = (await pool.query(`SELECT company_type FROM companies WHERE id=$1`, [jp.company_id])).rows[0];
  const jd = {
    title: jp.title, job_description: jp.job_description,
    required_skills: jp.required_skills, experience_level: jp.experience_level,
    min_years: jp.min_years_experience, persona_criteria: jp.persona_criteria,
    company_type: company?.company_type,
  };
  const jdQuery = `${jp.title}. Required skills: ${(jp.required_skills || []).map((s) => s.name).join(', ')}. ${jp.job_description}`;

  const resumes = (await pool.query(
    `SELECT id, applicant_name FROM resumes WHERE job_profile_id=$1 AND status='ingested'`,
    [jobProfileId]
  )).rows;

  const store = await Chroma.fromExistingCollection(embeddings, {
    collectionName: `resumes_job_${jobProfileId}`,
    url: process.env.CHROMADB_URL,
  });

  const total = resumes.length;
  let processed = 0;
  const collected = [];

  for (const resume of resumes) {
    const chunks = await store.asRetriever({
      k: 10, filter: { resume_id: resume.id },
    }).getRelevantDocuments(jdQuery);

    const messages = buildPrompt(jd, { resume_id: resume.id, name: resume.applicant_name }, chunks);

    await bucket.take(1);
    const completion = await withBackoff(() =>
      openai.chat.completions.create({
        model: 'gpt-4o',
        messages,
        temperature: 0.1,
        response_format: { type: 'json_object' },
      })
    );

    let parsed;
    try {
      parsed = JSON.parse(completion.choices[0].message.content);
    } catch (e) {
      logger.error('llm_json_parse_failed', { correlationId, resumeId: resume.id });
      continue;
    }

    // Validate single-result shape against the rankings item schema
    const wrapped = { job_profile_id: jobProfileId, run_id: runId, rankings: [parsed] };
    if (!validate(wrapped)) {
      logger.error('llm_schema_invalid', { correlationId, resumeId: resume.id, errors: validate.errors });
      continue;
    }

    await persistRanking(jobProfileId, runId, parsed);
    collected.push(parsed);
    processed++;

    io.to(`job:${jobProfileId}`).emit('ranking:result', {
      jobProfileId, runId,
      result: {
        resumeId: parsed.resume_id, applicantName: parsed.applicant_name,
        score: parsed.score, tier: parsed.tier,
        skillScore: parsed.skill_score, experienceScore: parsed.experience_score,
        projectScore: parsed.project_score, companyTypeScore: parsed.company_type_score,
        achievementScore: parsed.achievement_score,
      },
    });
    io.to(`job:${jobProfileId}`).emit('ranking:progress', {
      jobProfileId, runId, processed, total,
      percent: Math.round((processed / total) * 100),
    });
  }

  // Assign ranks by score and persist rank column
  collected.sort((a, b) => b.score - a.score);
  for (let i = 0; i < collected.length; i++) {
    await pool.query(
      `UPDATE match_results SET rank=$1 WHERE run_id=$2 AND resume_id=$3`,
      [i + 1, runId, collected[i].resume_id]
    );
  }

  await pool.query(`UPDATE job_profiles SET status='ranked' WHERE id=$1`, [jobProfileId]);
  await publishExcelExport(jobProfileId, runId, correlationId);

  logger.info('ranking_complete', { correlationId, jobProfileId, runId, ranked: collected.length });
  return { runId, ranked: collected.length };
}

module.exports = { runRanking };
```

> **OpenAI Batch API variant:** for 1000+ resumes, instead of per-resume `chat.completions.create`, write one
> JSONL line per resume (`{custom_id: resume_id, method:"POST", url:"/v1/chat/completions", body:{...}}`),
> upload via `openai.files.create({purpose:'batch'})`, submit `openai.batches.create({input_file_id, endpoint, completion_window:'24h'})`,
> poll `openai.batches.retrieve(id)` until `completed`, then download the output file and run the same
> validate→persist→emit loop over each line. The token bucket + `withBackoff` still guard the submit/poll calls.

