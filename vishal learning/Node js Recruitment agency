## 3.6 Redis Caching Middleware (Express.js)

```js
// middleware/cache.js
const Redis = require('ioredis');
const redis = new Redis(process.env.REDIS_URL);
const logger = require('../logger');

/**
 * Cache-aside middleware factory for GET routes.
 * @param {(req)=>string} keyBuilder  build cache key from request
 * @param {number} ttlSeconds
 */
function cache(keyBuilder, ttlSeconds) {
  return async (req, res, next) => {
    let key;
    try {
      key = keyBuilder(req);
      const cached = await redis.get(key);
      if (cached) {
        res.setHeader('X-Cache', 'HIT');
        return res.status(200).json(JSON.parse(cached));
      }
    } catch (err) {
      logger.warn('cache_read_failed', { error: err.message }); // fail open
      return next();
    }

    // Intercept res.json to populate cache on the way out
    const originalJson = res.json.bind(res);
    res.json = (body) => {
      if (res.statusCode >= 200 && res.statusCode < 300) {
        redis.set(key, JSON.stringify(body), 'EX', ttlSeconds).catch((e) =>
          logger.warn('cache_write_failed', { error: e.message })
        );
      }
      res.setHeader('X-Cache', 'MISS');
      return originalJson(body);
    };
    next();
  };
}

/** Invalidate one or many keys/patterns. */
async function invalidate(keysOrPatterns) {
  const arr = Array.isArray(keysOrPatterns) ? keysOrPatterns : [keysOrPatterns];
  for (const k of arr) {
    try {
      if (k.includes('*')) {
        const keys = await redis.keys(k);
        if (keys.length) await redis.del(keys);
      } else {
        await redis.del(k);
      }
    } catch (err) {
      logger.warn('cache_invalidate_failed', { key: k, error: err.message });
    }
  }
}

module.exports = { cache, invalidate };

