### ChromaDB upsert with metadata
```js
const { Chroma } = require('@langchain/community/vectorstores/chroma');

async function upsertChunks(jobProfileId, docs /* LangChain Document[] with metadata */) {
  const collectionName = `resumes_job_${jobProfileId}`;
  const store = await Chroma.fromExistingCollection(embeddings, {
    collectionName,
    url: process.env.CHROMADB_URL,
    collectionMetadata: { 'hnsw:space': 'cosine' },
  }).catch(async () =>
    Chroma.fromDocuments(docs, embeddings, {
      collectionName,
      url: process.env.CHROMADB_URL,
      collectionMetadata: { 'hnsw:space': 'cosine' },
    })
  );
  // idempotent: ids are deterministic chunk_ids
  const ids = docs.map((d) => d.metadata.chunk_id);
  await store.addDocuments(docs, { ids });
  return collectionName;
}
```

### Retrieval (top-K=10 filtered by resume_id)
```js
async function retrieveForResume(jobProfileId, resumeId, jdQueryText, k = 10) {
  const store = await Chroma.fromExistingCollection(embeddings, {
    collectionName: `resumes_job_${jobProfileId}`,
    url: process.env.CHROMADB_URL,
  });
  const retriever = store.asRetriever({
    k,
    filter: { resume_id: resumeId },
  });
  return retriever.getRelevantDocuments(jdQueryText);
}
```

