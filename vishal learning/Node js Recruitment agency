## 3.9 Optimistic Locking — PostgreSQL Update (Node.js)

```ts
// db/match-result.repo.ts
import { Pool } from 'pg';

export interface MatchResult {
  id: string; jobProfileId: string; resumeId: string; runId: string;
  applicantName: string; rank: number | null; score: number;
  tier: 'Strong Yes' | 'Yes' | 'Maybe' | 'No';
  skillScore: number; experienceScore: number; projectScore: number;
  companyTypeScore: number; achievementScore: number;
  strengths: string[]; gaps: string[];
  personaFit: string; projectHighlight: string; recommendation: string;
  version: number;
}

const pool = new Pool({ connectionString: process.env.DATABASE_URL });

function sleep(ms: number) { return new Promise((r) => setTimeout(r, ms)); }

async function fetchById(id: string): Promise<MatchResult | null> {
  const { rows } = await pool.query('SELECT * FROM match_results WHERE id=$1', [id]);
  if (!rows[0]) return null;
  const r = rows[0];
  return {
    id: r.id, jobProfileId: r.job_profile_id, resumeId: r.resume_id, runId: r.run_id,
    applicantName: r.applicant_name, rank: r.rank, score: Number(r.score), tier: r.tier,
    skillScore: Number(r.skill_score), experienceScore: Number(r.experience_score),
    projectScore: Number(r.project_score), companyTypeScore: Number(r.company_type_score),
    achievementScore: Number(r.achievement_score),
    strengths: r.strengths, gaps: r.gaps, personaFit: r.persona_fit,
    projectHighlight: r.project_highlight, recommendation: r.recommendation,
    version: r.version,
  };
}

/**
 * Update with optimistic locking. Retries up to `maxRetries` on version conflict,
 * re-fetching the fresh row + reapplying `mutate` each time.
 */
export async function updateWithOptimisticLock(
  id: string,
  mutate: (current: MatchResult) => Partial<MatchResult>,
  maxRetries = 3
): Promise<MatchResult> {
  let attempt = 0;
  for (;;) {
    const current = await fetchById(id);
    if (!current) throw new Error(`MatchResult ${id} not found`);

    const patch = mutate(current);
    const next = { ...current, ...patch };

    const { rowCount, rows } = await pool.query(
      `UPDATE match_results SET
         rank=$1, score=$2, tier=$3, skill_score=$4, experience_score=$5,
         project_score=$6, company_type_score=$7, achievement_score=$8,
         strengths=$9, gaps=$10, persona_fit=$11, project_highlight=$12,
         recommendation=$13, version=version+1
       WHERE id=$14 AND version=$15
       RETURNING *`,
      [
        next.rank, next.score, next.tier, next.skillScore, next.experienceScore,
        next.projectScore, next.companyTypeScore, next.achievementScore,
        JSON.stringify(next.strengths), JSON.stringify(next.gaps),
        next.personaFit, next.projectHighlight, next.recommendation,
        id, current.version,
      ]
    );

    if (rowCount === 1) {
      const r = rows[0];
      return { ...next, version: r.version };
    }

    // Version conflict
    attempt++;
    if (attempt > maxRetries) {
      throw new Error(`Optimistic lock failed for ${id} after ${maxRetries} retries`);
    }
    await sleep(Math.pow(2, attempt) * 50); // 100ms, 200ms, 400ms
  }
}
