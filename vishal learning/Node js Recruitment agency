## Appendix — Notification & Delivery Worker (reference)

```js
// workers/export.worker.js  (consumes excel.export.queue → generates → publishes notification)
const amqp = require('amqplib');
const { generateAndUploadExcel } = require('../export/excel-export');
const { getSignedUrl } = require('@aws-sdk/s3-request-presigner');
const { S3Client, GetObjectCommand } = require('@aws-sdk/client-s3');
const { pool } = require('../db');
const logger = require('../logger');

const s3 = new S3Client({ region: process.env.AWS_REGION });

async function start() {
  const conn = await amqp.connect(process.env.RABBITMQ_URL);
  const ch = await conn.createChannel();
  await ch.assertQueue('excel.export.queue', { durable: true });
  await ch.assertQueue('notification.dispatch.queue', { durable: true });
  ch.prefetch(2);

  ch.consume('excel.export.queue', async (msg) => {
    if (!msg) return;
    const { jobProfileId, runId, correlationId } = JSON.parse(msg.content.toString());
    try {
      const { s3Key } = await generateAndUploadExcel({ jobProfileId, runId, correlationId });
      const excelUrl = await getSignedUrl(
        s3, new GetObjectCommand({ Bucket: process.env.S3_BUCKET, Key: s3Key }),
        { expiresIn: 86400 }
      );
      // Notify HR recipients assigned to this profile
      const hrs = (await pool.query(
        `SELECT u.id FROM users u WHERE u.role_id=(SELECT id FROM roles WHERE name='HR')`
      )).rows;
      for (const hr of hrs) {
        await pool.query(
          `INSERT INTO notifications (recipient_id, job_profile_id, type, title, body, payload)
           VALUES ($1,$2,'excel_ready','Ranking results ready','Your Excel export is ready.',$3)`,
          [hr.id, jobProfileId, JSON.stringify({ excelUrl, runId })]
        );
      }
      ch.sendToQueue(
        'notification.dispatch.queue',
        Buffer.from(JSON.stringify({ jobProfileId, runId, excelUrl, correlationId })),
        { persistent: true, correlationId }
      );
      logger.info('export_worker_done', { correlationId, jobProfileId, runId });
      ch.ack(msg);
    } catch (err) {
      logger.error('export_worker_failed', { correlationId, jobProfileId, error: err.message });
      ch.nack(msg, false, false);
    }
  });
}

start().catch((e) => { logger.error('export_boot_failed', { error: e.message }); process.exit(1); });
```

