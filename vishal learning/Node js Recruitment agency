    driver: bridge

volumes:
  pg-data:
  chroma-data:
  redis-data:
  rabbitmq-data:

services:
  postgresql:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: recruit
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: recruitment
    volumes:
      - pg-data:/var/lib/postgresql/data
      - ./db/init:/docker-entrypoint-initdb.d:ro
    ports: ["5432:5432"]
    networks: [recruit-net]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U recruit -d recruitment"]
      interval: 10s
      timeout: 5s
      retries: 5
    deploy:
      resources:
        limits: { cpus: '2.0', memory: 2G }

  chromadb:
    image: chromadb/chroma:latest
    environment:
      IS_PERSISTENT: "TRUE"
      ANONYMIZED_TELEMETRY: "FALSE"
    volumes:
      - chroma-data:/chroma/chroma
    ports: ["8000:8000"]
    networks: [recruit-net]
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/api/v1/heartbeat"]
      interval: 15s
      timeout: 5s
      retries: 5
    deploy:
      resources:
        limits: { cpus: '2.0', memory: 4G }

  redis:
    image: redis:7-alpine
    command: ["redis-server", "--appendonly", "yes"]
    volumes:
      - redis-data:/data
    ports: ["6379:6379"]
    networks: [recruit-net]
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5
    deploy:
      resources:
        limits: { cpus: '1.0', memory: 1G }

  rabbitmq:
    image: rabbitmq:3.13-management-alpine
    environment:
      RABBITMQ_DEFAULT_USER: recruit
      RABBITMQ_DEFAULT_PASS: ${RABBITMQ_PASSWORD}
    volumes:
      - rabbitmq-data:/var/lib/rabbitmq
    ports: ["5672:5672", "15672:15672"]
    networks: [recruit-net]
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "ping"]
      interval: 15s
      timeout: 10s
      retries: 5
    deploy:
      resources:
        limits: { cpus: '1.0', memory: 1G }

  express-api:
    build: { context: ., dockerfile: docker/api.Dockerfile }
    environment:
      <<: *common-env
      PORT: 4000
    ports: ["4000:4000"]
    depends_on:
      postgresql: { condition: service_healthy }
      redis: { condition: service_healthy }
      rabbitmq: { condition: service_healthy }
      chromadb: { condition: service_healthy }
    networks: [recruit-net]
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:4000/health"]
      interval: 15s
      timeout: 5s
      retries: 5
    deploy:
      replicas: 2
      resources:
        limits: { cpus: '1.0', memory: 1G }

  socketio-server:
    build: { context: ., dockerfile: docker/socket.Dockerfile }
    environment:
      <<: *common-env
      PORT: 4100
    ports: ["4100:4100"]
    depends_on:
      redis: { condition: service_healthy }
    networks: [recruit-net]
    deploy:
      replicas: 2
      resources:
        limits: { cpus: '0.5', memory: 512M }

  ingestion-worker:
    build: { context: ., dockerfile: docker/worker.Dockerfile }
    command: ["node", "workers/ingestion.worker.js"]
    environment:
      <<: *common-env
    depends_on:
      rabbitmq: { condition: service_healthy }
      chromadb: { condition: service_healthy }
      postgresql: { condition: service_healthy }
    networks: [recruit-net]
    deploy:
      replicas: 4
      resources:
        limits: { cpus: '2.0', memory: 2G }

  ranking-worker:
    build: { context: ., dockerfile: docker/worker.Dockerfile }
    command: ["node", "workers/ranking.orchestrator.js"]
    environment:
      <<: *common-env
    depends_on:
      rabbitmq: { condition: service_healthy }
      chromadb: { condition: service_healthy }
      postgresql: { condition: service_healthy }
      redis: { condition: service_healthy }
    networks: [recruit-net]
    deploy:
      replicas: 2
      resources:
        limits: { cpus: '1.5', memory: 1.5G }

  export-worker:
    build: { context: ., dockerfile: docker/worker.Dockerfile }
    command: ["node", "workers/export.worker.js"]
    environment:
      <<: *common-env
    depends_on:
      rabbitmq: { condition: service_healthy }
      postgresql: { condition: service_healthy }
    networks: [recruit-net]
    deploy:
      replicas: 2
      resources:
        limits: { cpus: '1.0', memory: 1G }

  nextjs-frontend:
    build: { context: ., dockerfile: docker/frontend.Dockerfile }
    environment:
      NEXT_PUBLIC_API_URL: ${NEXT_PUBLIC_API_URL}
      NEXT_PUBLIC_SOCKET_URL: ${NEXT_PUBLIC_SOCKET_URL}
    ports: ["3000:3000"]
    depends_on: [express-api, socketio-server]
    networks: [recruit-net]
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3000/api/health"]
      interval: 20s
      timeout: 5s
      retries: 5
    deploy:
      resources:
        limits: { cpus: '1.0', memory: 1G }
```

