## 2.3 RAG Pipeline Design (LangChain.js)

### Section-aware chunking
Resumes are split into logical sections before chunking, using heading heuristics + regex:

```js
// section-aware-splitter.js
const SECTION_PATTERNS = {
  skills:       /\b(technical skills|skills|technologies|tech stack|competencies)\b/i,
  experience:   /\b(work experience|professional experience|employment|experience)\b/i,
  projects:     /\b(projects|selected projects|key projects|portfolio)\b/i,
  achievements: /\b(achievements|awards|accomplishments|honors|certifications)\b/i,
  persona:      /\b(summary|profile|about me|objective|interests)\b/i,
};

/**
 * Split raw resume text into labelled sections, then chunk each section.
 * @param {string} text  Raw extracted resume text
 * @returns {Array<{section:string, content:string}>}
 */
function splitIntoSections(text) {
  const lines = text.split(/\r?\n/);
  const sections = [];
  let current = { section: 'persona', buffer: [] };

  for (const line of lines) {
    let matched = null;
    for (const [name, re] of Object.entries(SECTION_PATTERNS)) {
      // a heading line is short and matches a section keyword
      if (line.trim().length <= 60 && re.test(line)) { matched = name; break; }
    }
    if (matched) {
      if (current.buffer.length) {
        sections.push({ section: current.section, content: current.buffer.join('\n').trim() });
      }
      current = { section: matched, buffer: [] };
    } else {
      current.buffer.push(line);
    }
  }
  if (current.buffer.length) {
    sections.push({ section: current.section, content: current.buffer.join('\n').trim() });
  }
  return sections.filter((s) => s.content.length > 0);
}

module.exports = { splitIntoSections, SECTION_PATTERNS };
```

Each section is then chunked with `RecursiveCharacterTextSplitter` (`chunkSize: 800`, `chunkOverlap: 100`) so
long experience/projects sections become multiple chunks while preserving the `section` label as metadata.

