## 3.7 Redis Mutex for Race Condition Prevention (Node.js)

```js
// concurrency/redis-mutex.js
const crypto = require('crypto');
const Redis = require('ioredis');
const redis = new Redis(process.env.REDIS_URL);
const logger = require('../logger');

const RELEASE_LUA = `
if redis.call("get", KEYS[1]) == ARGV[1] then
  return redis.call("del", KEYS[1])
else
  return 0
end`;

const RENEW_LUA = `
if redis.call("get", KEYS[1]) == ARGV[1] then
  return redis.call("pexpire", KEYS[1], ARGV[2])
else
  return 0
end`;

async function acquireLock(key, ttlMs) {
  const token = crypto.randomBytes(16).toString('hex');
  const ok = await redis.set(key, token, 'NX', 'PX', ttlMs);
  return ok ? token : null;
}

async function releaseLock(key, token) {
  return redis.eval(RELEASE_LUA, 1, key, token);
}

async function renewLock(key, token, ttlMs) {
  return redis.eval(RENEW_LUA, 1, key, token, ttlMs);
}

/**
 * Run `fn` while holding a mutex, with automatic heartbeat renewal for
 * long-running operations. Releases safely even on error.
 */
async function withLock(key, ttlMs, fn) {
  const token = await acquireLock(key, ttlMs);
  if (!token) {
    logger.warn('lock_not_acquired', { key });
    throw new Error(`Could not acquire lock: ${key}`);
  }
  const heartbeat = setInterval(() => {
    renewLock(key, token, ttlMs).catch((e) =>
      logger.warn('lock_renew_failed', { key, error: e.message })
    );
  }, Math.floor(ttlMs / 3));

  try {
    return await fn();
  } finally {
    clearInterval(heartbeat);
    await releaseLock(key, token).catch((e) =>
      logger.warn('lock_release_failed', { key, error: e.message })
    );
  }
}

module.exports = { acquireLock, releaseLock, renewLock, withLock };

// --- Usage: prevent duplicate RAG builds ---
