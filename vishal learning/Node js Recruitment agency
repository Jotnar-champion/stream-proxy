// --- Token bucket for OpenAI rate limiting ---
class TokenBucket {
  constructor(capacity, refillPerSec) {
    this.capacity = capacity; this.tokens = capacity;
    this.refillPerSec = refillPerSec; this.last = Date.now();
  }
  async take(n = 1) {
    for (;;) {
      const now = Date.now();
      this.tokens = Math.min(this.capacity, this.tokens + ((now - this.last) / 1000) * this.refillPerSec);
      this.last = now;
      if (this.tokens >= n) { this.tokens -= n; return; }
      await new Promise((r) => setTimeout(r, 250));
    }
  }
}
const bucket = new TokenBucket(60, 1); // ~60 req burst, refill 1/s

async function withBackoff(fn, max = 5) {
  let attempt = 0;
  for (;;) {
    try { return await fn(); }
    catch (err) {
      const status = err?.status || err?.response?.status;
      if (status !== 429 && status < 500) throw err;
      if (attempt >= max) throw err;
      const wait = Math.min(2 ** attempt * 1000 + Math.random() * 500, 30000);
      logger.warn('openai_backoff', { attempt, status, waitMs: wait });
      await new Promise((r) => setTimeout(r, wait));
      attempt++;
    }
  }
}

function buildPrompt(jd, applicant, chunks) {
