## 3.8 Socket.IO Real-time Progress (Express.js + Next.js)

### Server
```js
// realtime/io.js
const { Server } = require('socket.io');
const { createAdapter } = require('@socket.io/redis-adapter');
const Redis = require('ioredis');
const jwt = require('jsonwebtoken');
const logger = require('../logger');

let io;

function initSocket(httpServer) {
  io = new Server(httpServer, {
    cors: { origin: process.env.SOCKET_IO_ORIGIN.split(','), credentials: true },
  });

  // Redis adapter for horizontal scaling
  const pubClient = new Redis(process.env.REDIS_URL);
  const subClient = pubClient.duplicate();
  io.adapter(createAdapter(pubClient, subClient));

  // JWT auth handshake
  io.use((socket, next) => {
    const token = socket.handshake.auth?.token;
    if (!token) return next(new Error('Auth token required'));
    try {
      const payload = jwt.verify(token, process.env.JWT_ACCESS_SECRET);
      socket.user = payload;
      next();
    } catch (e) {
      next(new Error('Invalid token'));
    }
  });

  io.on('connection', (socket) => {
    socket.on('subscribe', ({ jobProfileId }) => {
      const { role, assigned_job_profile_ids = [] } = socket.user;
      if (role === 'HR' && !assigned_job_profile_ids.includes(jobProfileId)) {
        return socket.emit('error', { message: 'Not authorized for this job profile' });
      }
      socket.join(`job:${jobProfileId}`);
      logger.info('socket_subscribed', { user: socket.user.user_id, jobProfileId });
    });
    socket.on('unsubscribe', ({ jobProfileId }) => socket.leave(`job:${jobProfileId}`));
  });

  return io;
}

function getIO() {
  if (!io) throw new Error('Socket.IO not initialized');
  return io;
}

module.exports = { initSocket, getIO };
