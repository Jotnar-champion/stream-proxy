## 3.10 Full End-to-End Integration: Ranking Job Orchestrator (Node.js)

```js
// workers/ranking.orchestrator.js
const amqp = require('amqplib');
const { withLock } = require('../concurrency/redis-mutex');
const { runRanking } = require('../rag/ranking-pipeline');
const { generateAndUploadExcel } = require('../export/excel-export');
const { getIO } = require('../realtime/io');
const { pool } = require('../db');
const logger = require('../logger');

const { S3Client, GetObjectCommand } = require('@aws-sdk/client-s3');
const { getSignedUrl } = require('@aws-sdk/s3-request-presigner');
const s3 = new S3Client({ region: process.env.AWS_REGION });

const MAX_ATTEMPTS = 3;

async function handleRankingJob(msg, ch) {
  const { jobProfileId, correlationId } = JSON.parse(msg.content.toString());
  const attempt = msg.properties.headers['x-attempt'] || 0;
  const lockKey = `lock:rank:${jobProfileId}`;
  const startedAt = Date.now();

  try {
    await pool.query(`UPDATE job_profiles SET status='ranking' WHERE id=$1`, [jobProfileId]);

    const { runId, ranked } = await withLock(lockKey, 300000, async () => {
      logger.info('ranking_started', { correlationId, jobProfileId });
      return runRanking({ jobProfileId, correlationId });
    });

    // Generate Excel and upload to S3
    const { s3Key } = await generateAndUploadExcel({ jobProfileId, runId, correlationId });

    // Pre-signed download URL (24h)
    const excelUrl = await getSignedUrl(
      s3,
      new GetObjectCommand({ Bucket: process.env.S3_BUCKET, Key: s3Key }),
      { expiresIn: 86400 }
    );

    // Publish to notification dispatch queue
    await ch.assertQueue('notification.dispatch.queue', { durable: true });
    ch.sendToQueue(
      'notification.dispatch.queue',
      Buffer.from(JSON.stringify({ jobProfileId, runId, s3Key, excelUrl, correlationId })),
      { persistent: true, correlationId }
    );

    // Emit final completion event
    getIO().to(`job:${jobProfileId}`).emit('ranking:complete', {
      jobProfileId, runId, total: ranked, excelUrl,
      durationMs: Date.now() - startedAt,
    });

    // Audit log
    await pool.query(
      `INSERT INTO audit_logs (action, target_type, target_id, correlation_id, metadata)
       VALUES ('ranking.complete','job_profile',$1,$2,$3)`,
      [jobProfileId, correlationId, JSON.stringify({ runId, ranked })]
    );

    logger.info('ranking_job_done', { correlationId, jobProfileId, runId, ranked });
    ch.ack(msg);
  } catch (err) {
    logger.error('ranking_job_failed', { correlationId, jobProfileId, attempt, error: err.message });
    await pool.query(`UPDATE job_profiles SET status='open' WHERE id=$1`, [jobProfileId]).catch(() => {});

    if (attempt + 1 >= MAX_ATTEMPTS) {
      ch.nack(msg, false, false); // → DLQ
    } else {
      const delayMs = Math.pow(4, attempt) * 1000;
      setTimeout(() => {
        ch.publish('', 'ranking.job.queue', msg.content, {
          persistent: true, correlationId, headers: { 'x-attempt': attempt + 1 },
        });
        ch.ack(msg);
      }, delayMs);
    }
  }
}

async function start() {
  const conn = await amqp.connect(process.env.RABBITMQ_URL);
  const ch = await conn.createChannel();
  await ch.assertQueue('ranking.job.queue', {
    durable: true,
    arguments: { 'x-dead-letter-exchange': 'dlx.ranking.job' },
  });
  await ch.assertExchange('dlx.ranking.job', 'fanout', { durable: true });
  await ch.assertQueue('ranking.job.dlq', { durable: true });
  await ch.bindQueue('ranking.job.dlq', 'dlx.ranking.job', '');

  ch.prefetch(1); // one heavy ranking job at a time per orchestrator instance
  logger.info('ranking_orchestrator_started');
  ch.consume('ranking.job.queue', (msg) => { if (msg) handleRankingJob(msg, ch); });
}

start().catch((e) => { logger.error('orchestrator_boot_failed', { error: e.message }); process.exit(1); });
