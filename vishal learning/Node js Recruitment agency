    [jobProfileId, r.resume_id, runId, r.applicant_name, r.score, r.tier,
     r.skill_score, r.experience_score, r.project_score, r.company_type_score, r.achievement_score,
     JSON.stringify(r.strengths), JSON.stringify(r.gaps),
     r.persona_fit, r.project_highlight, r.recommendation]
