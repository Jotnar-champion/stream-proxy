## 3.2 MQ Worker — Resume Ingestion (Node.js)

```js
// workers/ingestion.worker.js
const amqp = require('amqplib');
const crypto = require('crypto');
const Redis = require('ioredis');
const pLimit = require('p-limit');
const { S3Client, GetObjectCommand } = require('@aws-sdk/client-s3');
const { PDFLoader } = require('@langchain/community/document_loaders/fs/pdf');
const { RecursiveCharacterTextSplitter } = require('langchain/text_splitter');
const { HuggingFaceTransformersEmbeddings } = require('@langchain/community/embeddings/huggingface_transformers');
const { ChromaClient } = require('chromadb');

const { splitIntoSections } = require('../rag/section-aware-splitter');
const { pool } = require('../db');
const logger = require('../logger');

const redis = new Redis(process.env.REDIS_URL);
const s3 = new S3Client({ region: process.env.AWS_REGION });
const chroma = new ChromaClient({ path: process.env.CHROMADB_URL });
const embeddings = new HuggingFaceTransformersEmbeddings({
  model: 'sentence-transformers/all-MiniLM-L6-v2',
});

const MAX_CONCURRENT = 10;
const MAX_ATTEMPTS = 3;
const limit = pLimit(MAX_CONCURRENT);

async function streamToBuffer(stream) {
  const chunks = [];
  for await (const c of stream) chunks.push(c);
  return Buffer.concat(chunks);
}

function chunkId(resumeId, section, index) {
  return crypto.createHash('sha256').update(`${resumeId}:${section}:${index}`).digest('hex');
}

async function getCollection(jobProfileId) {
  return chroma.getOrCreateCollection({
    name: `resumes_job_${jobProfileId}`,
    metadata: { 'hnsw:space': 'cosine' },
  });
}

async function processMessage(msg, ch) {
  const data = JSON.parse(msg.content.toString());
  const { resumeId, jobProfileId, s3Key, correlationId } = data;
  const attempt = (msg.properties.headers['x-attempt'] || 0);

  try {
    await pool.query(`UPDATE resumes SET status='ingesting' WHERE id=$1`, [resumeId]);

    // 1. Download PDF from S3
    const obj = await s3.send(new GetObjectCommand({ Bucket: process.env.S3_BUCKET, Key: s3Key }));
    const pdfBuffer = await streamToBuffer(obj.Body);

    // 2. Parse with PDFLoader (write to a Blob the loader accepts)
    const blob = new Blob([pdfBuffer], { type: 'application/pdf' });
    const loader = new PDFLoader(blob, { splitPages: false });
    const docs = await loader.load();
    const rawText = docs.map((d) => d.pageContent).join('\n');

    // Delta upsert: skip if content unchanged
    const contentHash = crypto.createHash('sha256').update(rawText).digest('hex');
    const existing = await pool.query(
      `SELECT content_hash FROM resumes WHERE id=$1`, [resumeId]
    );
    if (existing.rows[0]?.content_hash === contentHash) {
      await pool.query(`UPDATE resumes SET status='ingested' WHERE id=$1`, [resumeId]);
      ch.ack(msg);
      return;
    }

    // 3. Section-aware chunking
    const sections = splitIntoSections(rawText);
    const splitter = new RecursiveCharacterTextSplitter({ chunkSize: 800, chunkOverlap: 100 });

    const chunkRecords = [];
    for (const { section, content } of sections) {
      const pieces = await splitter.splitText(content);
      pieces.forEach((piece, i) => {
        const id = chunkId(resumeId, section, i);
        chunkRecords.push({ id, section, index: i, content: piece });
      });
    }

    // 4. Embed all chunks
    const vectors = await embeddings.embedDocuments(chunkRecords.map((c) => c.content));

    // 5. Atomic-ish: ChromaDB upsert + PostgreSQL insert in a transaction
    const collection = await getCollection(jobProfileId);

    // Idempotency dedup guard
    const newRecords = [];
    for (const rec of chunkRecords) {
      const seen = await redis.set(`ingest:done:${rec.id}`, '1', 'NX', 'EX', 86400);
      if (seen) newRecords.push(rec);
    }
    const recordsToWrite = newRecords.length ? newRecords : chunkRecords;
    const idxMap = recordsToWrite.map((r) => chunkRecords.indexOf(r));

    await collection.upsert({
      ids: recordsToWrite.map((r) => r.id),
      embeddings: idxMap.map((i) => vectors[i]),
      documents: recordsToWrite.map((r) => r.content),
      metadatas: recordsToWrite.map((r) => ({
        chunk_id: r.id, resume_id: resumeId, job_profile_id: jobProfileId,
        section: r.section, chunk_index: r.index, content_hash: contentHash,
      })),
    });

    const client = await pool.connect();
    try {
      await client.query('BEGIN');
      for (const r of recordsToWrite) {
        await client.query(
          `INSERT INTO resume_chunks
             (chunk_id, resume_id, job_profile_id, section, chunk_index, content, metadata)
           VALUES ($1,$2,$3,$4,$5,$6,$7)
           ON CONFLICT (chunk_id) DO UPDATE
             SET content = EXCLUDED.content, metadata = EXCLUDED.metadata`,
          [r.id, resumeId, jobProfileId, r.section, r.index, r.content,
           JSON.stringify({ content_hash: contentHash })]
        );
      }
      await client.query(
        `UPDATE resumes SET status='ingested', content_hash=$2 WHERE id=$1`,
        [resumeId, contentHash]
      );
      await client.query('COMMIT');
    } catch (e) {
      await client.query('ROLLBACK');
      throw e;
    } finally {
      client.release();
    }

    logger.info('resume_ingested', { correlationId, resumeId, chunks: recordsToWrite.length });
    ch.ack(msg);
  } catch (err) {
    logger.error('ingestion_failed', { correlationId, resumeId, attempt, error: err.message });

    if (attempt + 1 >= MAX_ATTEMPTS) {
      await pool.query(
        `UPDATE resumes SET status='failed', error_message=$2 WHERE id=$1`,
        [resumeId, err.message]
      );
      ch.nack(msg, false, false); // → DLQ
    } else {
      // Exponential backoff republish: 1s, 4s, 16s
      const delayMs = Math.pow(4, attempt) * 1000;
      setTimeout(() => {
        ch.publish('', 'resume.ingestion.queue', msg.content, {
          persistent: true, correlationId,
          headers: { 'x-attempt': attempt + 1 },
        });
        ch.ack(msg);
      }, delayMs);
    }
  }
}

async function start() {
  const conn = await amqp.connect(process.env.RABBITMQ_URL);
  const ch = await conn.createChannel();
  await ch.assertQueue('resume.ingestion.queue', {
    durable: true,
    arguments: { 'x-dead-letter-exchange': 'dlx.resume.ingestion' },
  });
  await ch.assertExchange('dlx.resume.ingestion', 'fanout', { durable: true });
  await ch.assertQueue('resume.ingestion.dlq', { durable: true });
  await ch.bindQueue('resume.ingestion.dlq', 'dlx.resume.ingestion', '');

  ch.prefetch(MAX_CONCURRENT);
  logger.info('ingestion_worker_started', { concurrency: MAX_CONCURRENT });

  ch.consume('resume.ingestion.queue', (msg) => {
    if (msg) limit(() => processMessage(msg, ch));
  });
}

start().catch((e) => { logger.error('worker_boot_failed', { error: e.message }); process.exit(1); });
