## 3.1 Bulk Resume Upload Endpoint (Express.js)

```js
// routes/upload.routes.js
const express = require('express');
const multer = require('multer');
const crypto = require('crypto');
const { v4: uuidv4 } = require('uuid');
const { S3Client, PutObjectCommand } = require('@aws-sdk/client-s3');
const { getSignedUrl } = require('@aws-sdk/s3-request-presigner');
const amqp = require('amqplib');
const Redis = require('ioredis');

const { requireRole } = require('../middleware/rbac');
const { pool } = require('../db');
const logger = require('../logger');

const router = express.Router();
const redis = new Redis(process.env.REDIS_URL);
const s3 = new S3Client({ region: process.env.AWS_REGION });

const PDF_MAGIC = Buffer.from([0x25, 0x50, 0x44, 0x46]); // %PDF

const upload = multer({
  storage: multer.memoryStorage(),
  limits: { fileSize: 10 * 1024 * 1024, files: 50 }, // 10MB, 50 files
  fileFilter: (req, file, cb) => {
    if (file.mimetype !== 'application/pdf') {
      return cb(new Error('Only PDF files are allowed'));
    }
    cb(null, true);
  },
});

let channel;
async function getChannel() {
  if (channel) return channel;
  const conn = await amqp.connect(process.env.RABBITMQ_URL);
  channel = await conn.createConfirmChannel();
  await channel.assertQueue('resume.ingestion.queue', { durable: true });
  return channel;
}

function isPdf(buffer) {
  return buffer && buffer.length >= 4 && buffer.subarray(0, 4).equals(PDF_MAGIC);
}

router.post(
  '/job-profiles/:jobProfileId/resumes/bulk',
  requireRole(['SuperAdmin', 'AgencyAdmin', 'Recruiter']),
  upload.array('resumes', 50),
  async (req, res) => {
    const correlationId = req.headers['x-correlation-id'] || uuidv4();
    const { jobProfileId } = req.params;
    const batchId = req.headers['x-batch-id'] || uuidv4();

    try {
      if (!req.files || req.files.length === 0) {
        return res.status(400).json({ error: 'No files uploaded' });
      }

      // Idempotency: dedupe accidental re-submission of the same batch
      const idemKey = `upload:batch:${jobProfileId}:${batchId}`;
      const firstTime = await redis.set(idemKey, '1', 'NX', 'EX', 86400);
      if (!firstTime) {
        return res.status(409).json({ error: 'Duplicate batch', batchId });
      }

      // Validate job profile ownership / existence
      const jp = await pool.query(
        'SELECT id, agency_id FROM job_profiles WHERE id = $1',
        [jobProfileId]
      );
      if (jp.rowCount === 0) {
        await redis.del(idemKey);
        return res.status(404).json({ error: 'Job profile not found' });
      }

      const ch = await getChannel();
      const accepted = [];
      const rejected = [];

      for (const file of req.files) {
        // Magic-byte validation (not just extension/mime)
        if (!isPdf(file.buffer)) {
          rejected.push({ name: file.originalname, reason: 'Invalid PDF signature' });
          continue;
        }

        const resumeId = uuidv4();
        const s3Key = `resumes/${jp.rows[0].agency_id}/${batchId}/${resumeId}.pdf`;

        // Upload to S3
        await s3.send(
          new PutObjectCommand({
            Bucket: process.env.S3_BUCKET,
            Key: s3Key,
            Body: file.buffer,
            ContentType: 'application/pdf',
            ServerSideEncryption: 'AES256',
          })
        );

        // Persist resume metadata
        await pool.query(
          `INSERT INTO resumes (id, job_profile_id, batch_id, s3_key, status)
           VALUES ($1, $2, $3, $4, 'uploaded')`,
          [resumeId, jobProfileId, batchId, s3Key]
        );

        // Publish ingestion job (publisher confirm)
        const payload = Buffer.from(
          JSON.stringify({ resumeId, jobProfileId, s3Key, batchId, correlationId })
        );
        await new Promise((resolve, reject) => {
          ch.sendToQueue('resume.ingestion.queue', payload, {
            persistent: true,
            messageId: resumeId,
            correlationId,
            headers: { 'x-attempt': 0 },
          }, (err) => (err ? reject(err) : resolve()));
        });

        accepted.push({ resumeId, name: file.originalname });
      }

      logger.info('bulk_upload_accepted', {
        correlationId, jobProfileId, batchId,
        accepted: accepted.length, rejected: rejected.length,
      });

      return res.status(202).json({
        batchId, correlationId,
        accepted, rejected,
        message: `${accepted.length} resumes queued for ingestion`,
      });
    } catch (err) {
      logger.error('bulk_upload_failed', { correlationId, error: err.message });
      return res.status(500).json({ error: 'Upload failed', detail: err.message });
    }
  }
);

module.exports = router;
